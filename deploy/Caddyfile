# Serves the web build (the Dockerfile copies it into /srv) by the rules at the top of
# scripts/build-web.sh. Plain HTTP on 8080: the proxy in front (Traefik on Dokploy) does TLS.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv

	# For the container's health check.
	respond /healthz 200

	# The page names the other files, so it is revalidated on every load and a new build is seen.
	@page path / /index.html
	header @page Cache-Control "no-cache"
	# Every other file has a hash of its content in its name: cached for good. Only files that
	# exist, so a 404 isn't cached.
	@hashed {
		not path / /index.html
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header X-Content-Type-Options nosniff

	# The Dockerfile wrote a .br and a .gz beside each .wasm, .js, .html and .svg. The type comes
	# from the uncompressed name: application/wasm for the .wasm. The AVIF sheets and PNGs are
	# sent as they are, compressed already.
	file_server {
		precompressed br gzip
	}
}
